# systemd-юнит для запуска gunicorn (вариант БЕЗ Docker, с виртуальным окружением).
# Установка:
#   sudo cp deploy/gunicorn.service /etc/systemd/system/master-send.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now master-send
#
# Предполагается, что проект лежит в /var/www/master-send, venv — там же (.venv),
# переменные окружения — в /var/www/master-send/.env.

[Unit]
Description=Master Send (gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/master-send
EnvironmentFile=/var/www/master-send/.env
ExecStart=/var/www/master-send/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target