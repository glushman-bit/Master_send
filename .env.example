# Django secret key. Обязателен. Сгенерируйте свой:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Включить отладочный режим (True/False). В продакшене — обязательно False.
DEBUG=False

# Разрешённые хосты через запятую, например: example.com,www.example.com
ALLOWED_HOSTS=

# Разрешить любые CORS-источники (True/False). Для разрабоки True, для продакшена False.
CORS_ALLOW_ALL_ORIGINS=False

# Суперпользователь для команды `python manage.py csu` (необязательно, по умолчанию admin/admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin